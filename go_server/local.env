## App
ENVIRONMENT=development
HOST_URL=localhost:8081
HTTP_PORT=8081
HTTP_ADDRESS=localhost
GRPC_PORT=8082
GRPC_ADDRESS=localhost
INIT_TIMEOUT=10s

## MongoDB users/auth store
## For local Docker Mongo, use DB_ADDR=mongodb://localhost:27017 and leave user/pass empty.
DB_ADDR=mongodb://localhost:27017
DB_USER=
DB_PASS=
DB_NAME=comics
DB_TABLE_USERS=users
DB_TABLE_COMICS=comics
DB_MAX_POOL_SIZE=100
DB_MIN_POOL_SIZE=0
DB_MAX_CONN_IDLE_TIME=5m
DB_MAX_CONN_LIFE_TIME=60m
DB_CONN_TIMEOUT=10s
DB_BACKOFF_TIMEOUT=15s

## Comics REST store
## Use sqlite for the checked-in local template. Put real Postgres credentials in ignored go_server/.env.
COMICS_DB_DRIVER=sqlite
COMICS_POSTGRES_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
COMICS_SQLITE_PATH=../src/db/comics.db

## Optional Python scraper proxy. Leave blank for /scrape to return 501.
PY_BACKEND_URL=

## CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://localhost:3000,http://127.0.0.1:3000,https://127.0.0.1:3000,https://estebmaister.github.io

## Local HTTP TLS. Production deploys should leave these blank and use platform TLS.
HTTP_TLS_CERT_FILE=../tls/comics.crt
HTTP_TLS_KEY_FILE=../tls/comics.key

## JWT
ACCESS_TOKEN_EXPIRY_HOUR=1h
REFRESH_TOKEN_EXPIRY_HOUR=168h
ACCESS_TOKEN_SECRET="secret"
REFRESH_TOKEN_SECRET="another secret"

## OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

## Tracing
OTEL_EXPORTER_GRPC_ENDPOINT=
OTEL_EXPORTER_SECURE=false
OTEL_SERVICE_NAME=comics_service
OTEL_TRACES_SAMPLER_PERCENTAGE=10

## Logging
LOG_LEVEL=debug
LOG_DEBUG_CONSOLE=true
LOG_OUTPUT_FILE=.observability/log/logs.log
LOG_MAX_SIZE_MB=1
LOG_MAX_BACKUPS=3
LOG_MAX_AGE_DAYS=7
LOG_COMPRESS=true
