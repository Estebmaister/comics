#!/usr/bin/env sh
# Optional AI commit message assist — never replaces -m / merge / squash messages.

set -e

ROOT=$(git rev-parse --show-toplevel)
# shellcheck source=/dev/null
. "$ROOT/.githooks/common.sh"

COMMIT_MSG_FILE="${1:?}"
SOURCE="${2:-}"

if git diff --cached --quiet; then
  exit 0
fi

# Respect explicit messages and automated commit flows.
case "$SOURCE" in
  message|merge|squash|commit)
    exit 0
    ;;
esac

if comics_commit_msg_has_subject "$COMMIT_MSG_FILE"; then
  exit 0
fi

if ! comics_ai_hooks_enabled; then
  exit 0
fi

if [ "${COMICS_AI_COMMIT_MSG:-}" = "0" ]; then
  exit 0
fi

# Default: only assist interactive (template) commits when COMICS_HOOKS_AI=1.
if [ "${COMICS_AI_COMMIT_MSG:-}" != "1" ] && [ "$SOURCE" != "template" ] && [ -n "$SOURCE" ]; then
  exit 0
fi

tmp_prompt=$(mktemp) || exit 0
trap 'rm -f "$tmp_prompt"' EXIT

{
  printf '%s\n\n' "Write a concise git commit message (subject line, optional body). Output only the message text, no quotes."
  printf '%s\n\n' "Staged diff:"
  comics_staged_diff
} > "$tmp_prompt" || exit 0

msg=$(comics_ollama_generate "$tmp_prompt") || exit 0
[ -n "$msg" ] || exit 0

# Append as comments so the user can edit; # lines are stripped from the final commit.
{
  printf '\n'
  printf '%s\n' "$msg" | sed 's/^/# /'
} >> "$COMMIT_MSG_FILE"
