#!/usr/bin/env sh
# Fast safety checks; optional Ollama tasks when COMICS_HOOKS_AI=1.

set -e

ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT"

# shellcheck source=/dev/null
. "$ROOT/.githooks/common.sh"

# Reject committing server.pid
if git diff --cached --name-only | grep -qE '^server\.pid$'; then
  echo >&2 "✖  ERROR: You must not commit server.pid"
  exit 1
fi

if [ -f server.pid ]; then
  if [ -t 0 ]; then
    echo >&2 "⚠  WARNING: server.pid found in working tree."
    printf "Continue with commit? (y/n): "
    read -r answer </dev/tty
    case "$answer" in
      [Yy]*) ;;
      *) echo "Aborting commit."; exit 1 ;;
    esac
  else
    echo >&2 "⚠  WARNING: server.pid present (non-interactive commit; continuing)."
  fi
fi

if comics_skip_hooks; then
  exit 0
fi

if ! comics_ai_hooks_enabled; then
  exit 0
fi

# Optional AI tasks (see .githooks/README.md)
./.githooks/generate_docs.sh &
pid1=$!
./.githooks/lint_ai.sh &
pid2=$!

wait "$pid1" || true
wait "$pid2" || true

echo "✅ Pre-commit finished (AI hooks were advisory only)."
exit 0
